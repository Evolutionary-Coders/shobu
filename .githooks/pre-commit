#!/bin/sh
# o hook do commit é o rápido: formato e lint do que está no índice. o pipeline
# inteiro (tipos, teste, cobertura) roda no pre-push.
set -eu

planos=$(git diff --cached --name-only | grep -E '(^|/)plans/|\.plan\.md$' || true)
if [ -n "$planos" ]; then
  echo "commit recusado: documento de plano não entra no git." >&2
  echo "$planos" | sed 's/^/  /' >&2
  echo "  plano e especificação moram em plans/, que está no .gitignore." >&2
  echo "  decisão de arquitetura é outra coisa, e vai para docs/adr/." >&2
  exit 1
fi

# --no-errors-on-unmatched: commit só de markdown ou de yaml não tem o que lintar.
npx --no-install biome check --staged --files-ignore-unknown=true --no-errors-on-unmatched
